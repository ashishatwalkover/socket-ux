{
  "name": "socket-ux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "crg:init": "code-review-graph build .",
    "crg:watch": "code-review-graph watch .",
    "dev": "npm run crg:init && concurrently \"npm run crg:watch\" \"NODE_OPTIONS='--max-old-space-size=4096' next dev --turbopack\"",
    "dev:profile": "npm run crg:init && concurrently \"npm run crg:watch\" \"NODE_OPTIONS='--inspect --heap-prof --max-old-space-size=6144' next dev --turbopack\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.6.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
